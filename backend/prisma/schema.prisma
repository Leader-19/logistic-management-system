generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  COLLECTED
  AT_HUB
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────
// TENANCY & IDENTITY
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  logo      String?
  phone     String?
  email     String?
  address   String?
  timezone  String       @default("UTC")
  currency  String       @default("USD") @db.Char(3)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  settings     TenantSetting[]
  supportSessions PlatformSupportSession[]
  memberships  TenantMembership[]
  branches     Branch[]
  roles        Role[]
  customers    Customer[]
  shipments    Shipment[]
  invoices     Invoice[]
  productCategories ProductCategory[]
  products Product[]
  warehouses Warehouse[]
  inventoryBalances InventoryBalance[]
  stockMovements StockMovement[]
  vehicles Vehicle[]
  auditLogs    AuditLog[]
  proofOfDeliveries ProofOfDelivery[]
  notifications Notification[]
  subscription Subscription?

  @@map("tenants")
}

model TenantSetting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid @map("tenant_id")
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships TenantMembership[]
  platformSupportSessions PlatformSupportSession[] @relation("PlatformSupportAdmin")
  auditLogs   AuditLog[]
  notifications Notification[]

  @@map("users")
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid @map("tenant_id")
  userId    String           @db.Uuid @map("user_id")
  status    MembershipStatus @default(ACTIVE)
  branchId  String?          @db.Uuid @map("branch_id")
  invitationTokenHash String? @unique @map("invitation_token_hash")
  invitationExpiresAt DateTime? @map("invitation_expires_at")
  invitationRequiresPassword Boolean @default(false) @map("invitation_requires_password")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  membershipRoles MembershipRole[]
  assignedShipments Shipment[] @relation("AssignedDriver")
  notifications Notification[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_memberships")
}

model PlatformSupportSession {
  id                   String    @id @default(uuid()) @db.Uuid
  adminUserId          String    @db.Uuid @map("admin_user_id")
  tenantId             String    @db.Uuid @map("tenant_id")
  reason               String
  permissionKeys       String[]  @default([]) @map("permission_keys")
  startedAt            DateTime  @default(now()) @map("started_at")
  expiresAt            DateTime  @map("expires_at")
  endedAt              DateTime? @map("ended_at")

  admin  User   @relation("PlatformSupportAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([adminUserId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("platform_support_sessions")
}

// ─────────────────────────────────────────────────────────────
// ROLES & PERMISSIONS (Custom RBAC)
// ─────────────────────────────────────────────────────────────

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  resource    String // e.g. "shipments", "customers", "roles"
  action      String // e.g. "create", "read", "update", "delete", "manage", "export"
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String? @db.Uuid @map("tenant_id") // null = system role
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid @map("role_id")
  permissionId String @db.Uuid @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid @map("membership_id")
  roleId       String @db.Uuid @map("role_id")

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// ─────────────────────────────────────────────────────────────
// BRANCHES
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  code      String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("branches")
}

// ─────────────────────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Plan {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique
  description   String?
  monthlyPrice  Decimal @db.Decimal(10, 2) @map("monthly_price")
  yearlyPrice   Decimal @db.Decimal(10, 2) @map("yearly_price")
  isActive      Boolean @default(true) @map("is_active")
  sortOrder     Int     @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanFeature {
  id       String @id @default(uuid()) @db.Uuid
  planId   String @db.Uuid @map("plan_id")
  feature  String // e.g. "max_users", "max_branches", "max_shipments_monthly"
  value    String // e.g. "10", "3", "1000", "true"

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@map("plan_features")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @unique @db.Uuid @map("tenant_id")
  planId      String             @db.Uuid @map("plan_id")
  status      SubscriptionStatus @default(TRIALING)
  billingCycle String            @default("monthly") @map("billing_cycle")
  currentPeriodStart DateTime    @map("current_period_start")
  currentPeriodEnd   DateTime    @map("current_period_end")
  trialEndsAt DateTime?          @map("trial_ends_at")
  cancelledAt DateTime?          @map("cancelled_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  country   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shipments Shipment[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@map("customers")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  categoryId  String?  @db.Uuid @map("category_id")
  sku         String
  barcode     String?
  name        String
  imageUrl    String?  @map("image_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category           ProductCategory?   @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  stockMovements     StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("warehouses")
}

model Vehicle {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  registration   String
  vehicleType    String   @map("vehicle_type")
  make           String?
  model          String?
  capacityKg     Decimal? @db.Decimal(12, 3) @map("capacity_kg")
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, registration])
  @@index([tenantId, status])
  @@map("vehicles")
}

model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  warehouseId String   @db.Uuid @map("warehouse_id")
  productId   String   @db.Uuid @map("product_id")
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("inventory_balances")
}

model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid @map("tenant_id")
  warehouseId    String   @db.Uuid @map("warehouse_id")
  productId      String   @db.Uuid @map("product_id")
  quantityChange Decimal  @db.Decimal(14, 3) @map("quantity_change")
  quantityAfter  Decimal  @db.Decimal(14, 3) @map("quantity_after")
  reason         String
  actorId        String   @db.Uuid @map("actor_id")
  occurredAt     DateTime @default(now()) @map("occurred_at")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, warehouseId, recordedAt])
  @@index([tenantId, productId, recordedAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────
// SHIPMENTS & TRACKING
// ─────────────────────────────────────────────────────────────

model Shipment {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @db.Uuid @map("tenant_id")
  customerId       String         @db.Uuid @map("customer_id")
  trackingNumber   String         @unique @map("tracking_number")
  status           ShipmentStatus @default(BOOKED)
  senderName       String         @map("sender_name")
  senderPhone      String?        @map("sender_phone")
  senderAddress    String?        @map("sender_address")
  recipientName    String         @map("recipient_name")
  recipientPhone   String?        @map("recipient_phone")
  recipientAddress String         @map("recipient_address")
  weightGrams      Int            @map("weight_grams")
  lengthCm         Decimal?       @db.Decimal(8, 2) @map("length_cm")
  widthCm          Decimal?       @db.Decimal(8, 2) @map("width_cm")
  heightCm         Decimal?       @db.Decimal(8, 2) @map("height_cm")
  chargeAmount     Decimal        @db.Decimal(12, 2) @map("charge_amount")
  currency         String         @default("USD") @db.Char(3)
  serviceType      String?        @map("service_type")
  notes            String?
  assignedDriverId String?        @db.Uuid @map("assigned_driver_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  events   ShipmentEvent[]
  assignedDriver TenantMembership? @relation("AssignedDriver", fields: [tenantId, assignedDriverId], references: [tenantId, userId], onDelete: Restrict)
  proofOfDelivery ProofOfDelivery?
  invoice Invoice?

  @@unique([tenantId, id])
  @@unique([tenantId, trackingNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid @map("tenant_id")
  shipmentId String         @db.Uuid @map("shipment_id")
  sequence   Int            @default(1)
  status     ShipmentStatus
  note       String?
  location   String?
  actorId    String?        @db.Uuid @map("actor_id")
  source     String         @default("staff")
  occurredAt DateTime       @default(now()) @map("occurred_at")
  recordedAt DateTime       @default(now()) @map("recorded_at")

  shipment Shipment @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, shipmentId, sequence])
  @@index([tenantId, shipmentId, occurredAt])
  @@map("shipment_events")
}

model ProofOfDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid @map("tenant_id")
  shipmentId    String   @db.Uuid @map("shipment_id")
  recipientName String   @map("recipient_name")
  note          String?
  deliveredAt   DateTime @default(now()) @map("delivered_at")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  actorId       String?  @db.Uuid @map("actor_id")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shipment Shipment @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, shipmentId])
  @@index([tenantId, deliveredAt])
  @@map("proof_of_delivery")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid @map("tenant_id")
  shipmentId    String        @db.Uuid @map("shipment_id")
  invoiceNumber String        @map("invoice_number")
  status        String        @default("ISSUED")
  subtotal      Decimal       @db.Decimal(18, 4)
  taxRate       Decimal       @db.Decimal(7, 4) @map("tax_rate")
  taxAmount     Decimal       @db.Decimal(18, 4) @map("tax_amount")
  total         Decimal       @db.Decimal(18, 4)
  currency      String        @db.Char(3)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shipment Shipment      @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)
  lines    InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, shipmentId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid @map("tenant_id")
  invoiceId   String   @db.Uuid @map("invoice_id")
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(18, 4) @map("unit_price")
  lineTotal   Decimal  @db.Decimal(18, 4) @map("line_total")

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid @map("tenant_id")
  actorId    String?  @db.Uuid @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  outcome    String   @default("success")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}




model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid @map("tenant_id")
  userId    String   @db.Uuid @map("user_id")
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(1000)
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@index([tenantId, userId, readAt, createdAt])
  @@map("notifications")
}