generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum ShipmentStatus {
  BOOKED
  PICKUP_SCHEDULED
  COLLECTED
  AT_HUB
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────
// TENANCY & IDENTITY
// ─────────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  logo      String?
  phone     String?
  email     String?
  address   String?
  timezone  String       @default("UTC")
  currency  String       @default("USD") @db.Char(3)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  settings          TenantSetting[]
  supportSessions   PlatformSupportSession[]
  memberships       TenantMembership[]
  branches          Branch[]
  roles             Role[]
  customers         Customer[]
  shipments         Shipment[]
  invoices          Invoice[]
  invoiceTemplates  InvoiceTemplate[]
  productCategories ProductCategory[]
  products          Product[]
  warehouses        Warehouse[]
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  purchaseReceipts  PurchaseReceipt[]
  vehicles          Vehicle[]
  auditLogs         AuditLog[]
  proofOfDeliveries ProofOfDelivery[]
  packageTypes      PackageType[]
  notifications     Notification[]
  subscription      Subscription?

  @@map("tenants")
}

model TenantSetting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships             TenantMembership[]
  platformSupportSessions PlatformSupportSession[] @relation("PlatformSupportAdmin")
  auditLogs               AuditLog[]
  notifications           Notification[]
  idempotencyRecords      IdempotencyRecord[]

  @@map("users")
}

model TenantMembership {
  id                         String           @id @default(uuid()) @db.Uuid
  tenantId                   String           @map("tenant_id") @db.Uuid
  userId                     String           @map("user_id") @db.Uuid
  status                     MembershipStatus @default(ACTIVE)
  branchId                   String?          @map("branch_id") @db.Uuid
  invitationTokenHash        String?          @unique @map("invitation_token_hash")
  invitationExpiresAt        DateTime?        @map("invitation_expires_at")
  invitationRequiresPassword Boolean          @default(false) @map("invitation_requires_password")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  membershipRoles   MembershipRole[]
  assignedShipments Shipment[]       @relation("AssignedDriver")
  notifications     Notification[]

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("tenant_memberships")
}

model PlatformSupportSession {
  id             String    @id @default(uuid()) @db.Uuid
  adminUserId    String    @map("admin_user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  reason         String
  permissionKeys String[]  @default([]) @map("permission_keys")
  startedAt      DateTime  @default(now()) @map("started_at")
  expiresAt      DateTime  @map("expires_at")
  endedAt        DateTime? @map("ended_at")

  admin  User   @relation("PlatformSupportAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([adminUserId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("platform_support_sessions")
}

// ─────────────────────────────────────────────────────────────
// ROLES & PERMISSIONS (Custom RBAC)
// ─────────────────────────────────────────────────────────────

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  resource    String // e.g. "shipments", "customers", "roles"
  action      String // e.g. "create", "read", "update", "delete", "manage", "export"
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid // null = system role
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_roles")
}

// ─────────────────────────────────────────────────────────────
// BRANCHES
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("branches")
}

// ─────────────────────────────────────────────────────────────
// PLANS & SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  description  String?
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice  Decimal  @map("yearly_price") @db.Decimal(10, 2)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanFeature {
  id      String @id @default(uuid()) @db.Uuid
  planId  String @map("plan_id") @db.Uuid
  feature String // e.g. "max_users", "max_branches", "max_shipments_monthly"
  value   String // e.g. "10", "3", "1000", "true"

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, feature])
  @@map("plan_features")
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @unique @map("tenant_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(TRIALING)
  billingCycle         String             @default("monthly") @map("billing_cycle")
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  cancelledAt          DateTime?          @map("cancelled_at")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model BillingWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("billing_webhook_events")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  country   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shipments Shipment[]
  invoices  Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, email])
  @@map("customers")
}

model ProductCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  sku         String
  barcode     String?
  name        String
  imageUrl    String?  @map("image_url")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category             ProductCategory?      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  inventoryBalances    InventoryBalance[]
  stockMovements       StockMovement[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, name])
  @@map("products")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  inventoryBalances InventoryBalance[]
  stockMovements    StockMovement[]
  purchaseOrders    PurchaseOrder[]
  purchaseReceipts  PurchaseReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("warehouses")
}

model Vehicle {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  registration String
  vehicleType  String   @map("vehicle_type")
  make         String?
  model        String?
  capacityKg   Decimal? @map("capacity_kg") @db.Decimal(12, 3)
  status       String   @default("ACTIVE")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, registration])
  @@index([tenantId, status])
  @@map("vehicles")
}

model InventoryBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, warehouseId, productId])
  @@index([tenantId, productId])
  @@map("inventory_balances")
}

model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantityChange Decimal  @map("quantity_change") @db.Decimal(14, 3)
  quantityAfter  Decimal  @map("quantity_after") @db.Decimal(14, 3)
  reason         String
  actorId        String   @map("actor_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, warehouseId, recordedAt])
  @@index([tenantId, productId, recordedAt])
  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, isActive, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  supplierId  String              @map("supplier_id") @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  orderNumber String              @map("order_number")
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String              @db.Char(3)
  notes       String?
  expectedAt  DateTime?           @map("expected_at")
  orderedAt   DateTime?           @map("ordered_at")
  receivedAt  DateTime?           @map("received_at")
  createdBy   String              @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines     PurchaseOrderLine[]
  receipts  PurchaseReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, supplierId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 3)
  receivedQuantity Decimal  @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder         @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  product       Product               @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  receiptLines  PurchaseReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, purchaseOrderId, productId])
  @@index([tenantId, productId])
  @@map("purchase_order_lines")
}

model PurchaseReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  receiptNumber   String   @map("receipt_number")
  receivedBy      String   @map("received_by") @db.Uuid
  notes           String?
  receivedAt      DateTime @default(now()) @map("received_at")

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder         @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  warehouse     Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Restrict)
  lines         PurchaseReceiptLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId, purchaseOrderId, receivedAt])
  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  receiptId           String  @map("receipt_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  quantity            Decimal @db.Decimal(14, 3)

  receipt           PurchaseReceipt   @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict)
  product           Product           @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, purchaseOrderLineId])
  @@map("purchase_receipt_lines")
}

// ─────────────────────────────────────────────────────────────
// SHIPMENTS & TRACKING
// ─────────────────────────────────────────────────────────────

model PackageType {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  code            String
  name            String
  lengthCm        Decimal  @map("length_cm") @db.Decimal(8, 2)
  widthCm         Decimal  @map("width_cm") @db.Decimal(8, 2)
  heightCm        Decimal  @map("height_cm") @db.Decimal(8, 2)
  tareWeightGrams Int      @default(0) @map("tare_weight_grams")
  maxLoadGrams    Int      @map("max_load_grams")
  stackable       Boolean  @default(true)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, name])
  @@map("package_types")
}

model Shipment {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  trackingNumber   String         @unique @map("tracking_number")
  status           ShipmentStatus @default(BOOKED)
  senderName       String         @map("sender_name")
  senderPhone      String?        @map("sender_phone")
  senderAddress    String?        @map("sender_address")
  recipientName    String         @map("recipient_name")
  recipientPhone   String?        @map("recipient_phone")
  recipientAddress String         @map("recipient_address")
  weightGrams      Int            @map("weight_grams")
  lengthCm         Decimal?       @map("length_cm") @db.Decimal(8, 2)
  widthCm          Decimal?       @map("width_cm") @db.Decimal(8, 2)
  heightCm         Decimal?       @map("height_cm") @db.Decimal(8, 2)
  chargeAmount     Decimal        @map("charge_amount") @db.Decimal(12, 2)
  currency         String         @default("USD") @db.Char(3)
  serviceType      String?        @map("service_type")
  notes            String?
  assignedDriverId String?        @map("assigned_driver_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer        Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  events          ShipmentEvent[]
  assignedDriver  TenantMembership? @relation("AssignedDriver", fields: [tenantId, assignedDriverId], references: [tenantId, userId], onDelete: Restrict)
  proofOfDelivery ProofOfDelivery?
  invoice         Invoice?

  @@unique([tenantId, id])
  @@unique([tenantId, trackingNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  shipmentId String         @map("shipment_id") @db.Uuid
  sequence   Int            @default(1)
  status     ShipmentStatus
  note       String?
  location   String?
  actorId    String?        @map("actor_id") @db.Uuid
  source     String         @default("staff")
  occurredAt DateTime       @default(now()) @map("occurred_at")
  recordedAt DateTime       @default(now()) @map("recorded_at")

  shipment Shipment @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, shipmentId, sequence])
  @@index([tenantId, shipmentId, occurredAt])
  @@map("shipment_events")
}

model ProofOfDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  shipmentId    String   @map("shipment_id") @db.Uuid
  recipientName String   @map("recipient_name")
  note          String?
  deliveredAt   DateTime @default(now()) @map("delivered_at")
  recordedAt    DateTime @default(now()) @map("recorded_at")
  actorId       String?  @map("actor_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  shipment Shipment @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, shipmentId])
  @@index([tenantId, deliveredAt])
  @@map("proof_of_delivery")
}

model Invoice {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  shipmentId       String?   @map("shipment_id") @db.Uuid
  invoiceNumber    String    @map("invoice_number")
  status           String    @default("ISSUED")
  subtotal         Decimal   @db.Decimal(18, 4)
  taxRate          Decimal   @map("tax_rate") @db.Decimal(7, 4)
  taxAmount        Decimal   @map("tax_amount") @db.Decimal(18, 4)
  total            Decimal   @db.Decimal(18, 4)
  currency         String    @db.Char(3)
  dueAt            DateTime? @map("due_at")
  notes            String?
  headerNote       String?   @map("header_note")
  paymentTerms     String?   @map("payment_terms")
  footerNote       String?   @map("footer_note")
  templateSnapshot Json?     @map("template_snapshot")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  shipment Shipment?     @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Restrict)
  lines    InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, shipmentId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, issuedAt])
  @@index([tenantId, customerId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 4)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

model InvoiceTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  defaultSlot    String?  @map("default_slot")
  currentVersion Int      @default(1) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versions InvoiceTemplateVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, defaultSlot])
  @@map("invoice_templates")
}

model InvoiceTemplateVersion {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  version    Int
  layout     Json
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  template InvoiceTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, templateId, version])
  @@index([tenantId, templateId, createdAt])
  @@map("invoice_template_versions")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  outcome    String   @default("success")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(1000)
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@index([tenantId, userId, readAt, createdAt])
  @@map("notifications")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  scopeKey       String    @map("scope_key") @db.VarChar(80)
  actorId        String    @map("actor_id") @db.Uuid
  key            String    @db.VarChar(128)
  requestHash    String    @map("request_hash") @db.Char(64)
  responseBody   Json?     @map("response_body")
  responseStatus Int?      @map("response_status")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, actorId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
